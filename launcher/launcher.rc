// Identity and manifest of CHDLauncher.exe. The numbers follow version.txt (bump all three together).
#include <winver.h>

1 24 "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,2,0
PRODUCTVERSION  0,0,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "mpolizel"
            VALUE "FileDescription",  "Castlevania: Harmony of Despair PS3 Recomp launcher"
            VALUE "FileVersion",      "0.0.2"
            VALUE "InternalName",     "CHDLauncher"
            VALUE "LegalCopyright",   "Launcher code by mpolizel. Castlevania is a trademark of Konami; not affiliated."
            VALUE "OriginalFilename", "CHDLauncher.exe"
            VALUE "ProductName",      "CHDPS3Recomp"
            VALUE "ProductVersion",   "0.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

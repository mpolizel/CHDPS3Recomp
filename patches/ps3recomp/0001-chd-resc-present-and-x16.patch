+/* Texture -> render-target aliases. A title that copies a rendered surface to
+ * another VRAM address with the CPU or an SPU reads zeros: the surface only
+ * exists on the host GPU. An alias makes a texture bound at `tex` sample the
+ * render target at `rt` instead. Set from port code with
+ * rsx_d3d12_alias_texture_to_rt(), or TEX_ALIAS=tex=rt[,tex=rt...]. */
+#define MAX_TEX_ALIASES 16
+static u32 s_tex_alias_n;
+static u32 s_tex_alias_from[MAX_TEX_ALIASES], s_tex_alias_to[MAX_TEX_ALIASES];
+
+void rsx_d3d12_alias_texture_to_rt(u32 tex_off, u32 rt_off)
+{
+    for (u32 i = 0; i < s_tex_alias_n; i++)
+        if (s_tex_alias_from[i] == tex_off) { s_tex_alias_to[i] = rt_off; return; }
+    if (s_tex_alias_n < MAX_TEX_ALIASES) {
+        s_tex_alias_from[s_tex_alias_n] = tex_off;
+        s_tex_alias_to[s_tex_alias_n++] = rt_off;
+    }
+}
+
+static u32 tex_rt_alias(u32 off)
+{
+    static int parsed = 0;
+    if (!parsed) {
+        parsed = 1;
+        const char* e = getenv("TEX_ALIAS");
+        while (e && *e) {
+            char* end;
+            u32 from = (u32)strtoul(e, &end, 0);
+            if (*end != '=') break;
+            u32 to = (u32)strtoul(end + 1, &end, 0);
+            rsx_d3d12_alias_texture_to_rt(from, to);
+            fprintf(stderr, "[TEX_ALIAS] 0x%08X -> RT 0x%08X\n", from, to);
+            e = (*end == ',') ? end + 1 : NULL;
+        }
+    }
+    for (u32 i = 0; i < s_tex_alias_n; i++)
+        if (s_tex_alias_from[i] == off) return s_tex_alias_to[i];
+    return off;
+}

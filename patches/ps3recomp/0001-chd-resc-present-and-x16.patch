index a21adb80..52184be6 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -597,6 +597,80 @@ static void audio_dump_mix(void)
 
 #ifdef _WIN32
 static unsigned long long g_audio_underruns;
+
+#if AUDIO_BACKEND_WASAPI
+/* Submit s_mix_buffer resampled by (1 + c), c steering the device queue to a
+ * target fill (see the pacing note in audio_mix_thread_func). room = frames
+ * free in the device buffer, read just before this block was mixed. */
+static void audio_submit_drift(int room)
+{
+    enum { N = CELL_AUDIO_BLOCK_SAMPLES, OUT_MAX = N * 2 };
+    static float  hist[2];          /* last frame of the previous block (x[-1]) */
+    static double phase = 0.0;      /* read position in this block, x[-1] .. x[N-1] */
+    static double fill = -1.0;      /* smoothed device queue, frames */
+    static float  out[OUT_MAX * 2];
+    static float  zeros[4096 * 2];
+
+    const UINT32 buf = s_wasapi_buf_frames;
+    if (buf < 4 * N) { audio_backend_submit(s_mix_buffer, N); return; }
+    const double target = buf * 2.0 / 3.0;   /* 40 ms of a 60 ms buffer */
+    const int queued = (int)buf - room;
+
+    /* Start, or the device ran dry (a stall): a gap is happening anyway, so
+     * fill straight to the target with silence instead of crawling back. */
+    if (fill < 0.0 || queued < N / 2) {
+        if (fill >= 0.0) g_audio_underruns++;
+        int pad = (int)target - queued;
+        if (pad > 4096) pad = 4096;
+        if (pad > 0) audio_backend_submit(zeros, (u32)pad);
+        fill = target;
+    } else {
+        fill += (queued - fill) * 0.02;      /* ~0.27 s smoothing: devices pull in 10 ms chunks */
+    }
+
+    /* Proportional with a dead band: within 240 frames of the target the
+     * samples go out untouched (on the test machine the device and the
+     * counter agreed to ~10 ppm, so that is the usual case); past it, 1000
+     * frames off -> 0.2 %, clamped at 0.3 %, a ~10 s time constant. A device
+     * 230 ppm off settles ~355 frames from the target. */
+    const double band = 240.0, e = target - fill;
+    double c = e > band ? (e - band) * 2e-6 : e < -band ? (e + band) * 2e-6 : 0.0;
+    if (c > 0.003) c = 0.003;
+    if (c < -0.003) c = -0.003;
+    double step = 1.0 / (1.0 + c);
+    /* Untouched means whole-sample positions: glide a fractional phase left
+     * by an earlier correction back to one (at most 20 ppm, inaudible), so a
+     * steady interpolation does not soften the treble. */
+    if (c == 0.0) {
+        const double frac = phase - floor(phase);
+        if (frac > 1e-9) step += frac < 0.5 ? -fmin(frac, 2e-5 * N) / N : fmin(1.0 - frac, 2e-5 * N) / N;
+    }
+
+    const float* x = s_mix_buffer;
+    int n = 0;
+    while (phase < (double)(N - 1) && n < OUT_MAX) {
+        const int i = (int)floor(phase);      /* -1 .. N-2 */
+        const float f = (float)(phase - i);
+        float l0, r0;
+        if (i < 0) { l0 = hist[0]; r0 = hist[1]; }
+        else       { l0 = x[i * 2]; r0 = x[i * 2 + 1]; }
+        const float l1 = x[(i + 1) * 2], r1 = x[(i + 1) * 2 + 1];
+        out[n * 2]     = l0 + (l1 - l0) * f;
+        out[n * 2 + 1] = r0 + (r1 - r0) * f;
+        n++;
+        phase += step;
+    }
+    phase -= N;
+    hist[0] = x[(N - 1) * 2]; hist[1] = x[(N - 1) * 2 + 1];
+    audio_backend_submit(out, (u32)n);
+
+    { static int on = -1; if (on < 0) on = getenv("AUDIO_RATE") ? 1 : 0;
+      if (on) { static unsigned k; if (++k % 938 == 0)
+          fprintf(stderr, "[audio-drift] queue %d (avg %.0f, target %.0f), rate %+.0f ppm%c",
+                  queued, fill, target, c * 1e6, 10); } }
+}
+#endif

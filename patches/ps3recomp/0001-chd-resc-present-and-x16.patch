     (void)arg;
@@ -621,18 +695,32 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
      * dropped the surplus: 20% of the audio thrown away, and a guest mixer
      * (GH3's FMOD) that could not keep ahead of the read index played gaps.
      * With no device, pace on the performance counter instead. */
+    /*
+     * CHD port (2026-11-26): pace the guest on the performance counter, not on
+     * the device. The guest's own clocks (timebase, sys_time) run on the
+     * performance counter; the device's crystal does not, and on the test
+     * machine it ran ~230 ppm fast. Paced by the device, the read index gained
+     * a block on the guest every ~23 s, and HoD's Multistream logged "lagging
+     * by 1 packets to libAudio" and skipped a packet: a small click each time.
+     * Now the read index and the period events follow the guest's clock

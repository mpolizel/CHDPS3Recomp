+        "VO main(uint id:SV_VertexID) {\n"
+        "  VO o; float2 uv = float2((id << 1) & 2, id & 2);\n"
+        "  o.uv = uv; o.col = float4(1,1,1,1);\n"
+        "  o.pos = float4(uv * float2(2, -2) + float2(-1, 1), 0, 1); return o; }\n";

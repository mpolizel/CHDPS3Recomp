+/* A pass with more draws than MAX_DRAWS used to drop the excess (records_full):
+ * Castlevania: HoD's main menu records ~2100 draws between clears, and the
+ * last ones -- the button labels, drawn on top -- never appeared. Execute the
+ * batch so far without presenting, the way a clear boundary does, and keep
+ * recording. Only while a persistent offscreen scanout is set: that is the
+ * mode in which a mid-frame execute is never what gets shown. */
+static void d3d12_flush_if_full(void)
+{
+    if (!s_d3d.initialized || !s_scanout_offscreen) return;
+    if (s_d3d.draw_count + 8u < MAX_DRAWS) return;
+    s_present_this_frame = 0;
+    render_frame();
+    s_present_this_frame = 1;
+}

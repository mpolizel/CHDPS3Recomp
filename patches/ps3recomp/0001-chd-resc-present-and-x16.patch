+    HRESULT hr = D3DCompile(vs_src, sizeof(vs_src) - 1, "blit_vs", NULL, NULL, "main", "vs_5_0", 0, 0, &vb, &err);
+    if (SUCCEEDED(hr))
+        hr = D3DCompile(ps_src, sizeof(ps_src) - 1, "blit_ps", NULL, NULL, "main", "ps_5_0", 0, 0, &pb, &err);
+    if (FAILED(hr)) {
+        fprintf(stderr, "[COMPOSITE] blit shader compile failed: %s\n",
+                err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "?");
+        if (err) err->lpVtbl->Release(err);
+        if (vb) vb->lpVtbl->Release(vb);
+        s_blit_pso_failed = 1;
+        return 0;

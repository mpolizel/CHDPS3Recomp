+        "SamplerState smp : register(s0);\n"
+        "struct VO { float4 pos:SV_POSITION; float4 col:COLOR; float2 uv:TEXCOORD; };\n"
+        "float4 main(VO i) : SV_TARGET { return float4(tex.Sample(smp, i.uv).rgb, 1); }\n";
